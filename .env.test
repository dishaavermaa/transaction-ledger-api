# Used by the test suite. A separate database from development data.
#
# connection_limit matters here: the concurrency tests submit up to 100 requests
# at once, and each one opens its own interactive database transaction. If the
# pool were small, those requests would queue for a connection and run one at a
# time, and the tests would prove nothing about concurrent access. 30 lets plenty
# of them contend at the database simultaneously. (Operations on the same account
# still serialize there — on the account row lock — which is exactly the point.)
DATABASE_URL="postgresql://ledger:ledger@localhost:5544/ledger_test?schema=public&connection_limit=30"
PORT=3001
LOG_LEVEL=silent
MAX_PAGE_SIZE=100
