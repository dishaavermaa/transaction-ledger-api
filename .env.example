# Connection string for the application database.
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://ledger:ledger@localhost:5544/ledger?schema=public"

# HTTP server port.
PORT=3000

# Logger level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Maximum page size accepted by paginated endpoints.
MAX_PAGE_SIZE=100
